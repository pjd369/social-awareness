# Everything the "Deploy to Vercel" workflow (.github/workflows/vercel.yml)
# needs. Names only: a repository admin adds the values in GitHub under
# Settings → Secrets and variables → Actions. Never commit real values here.

# ── Variables tab ("New repository variable") ──────────────────────────────
# Firebase web app settings for the doodle leaderboard (Firebase console →
# Project settings → General → Your apps → Config). Not secret: they end up
# in the site's code; firestore.rules protects the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=

# ── Secrets tab ("New repository secret") ──────────────────────────────────
# Vercel access token: Vercel → Account settings → Tokens → Create.
VERCEL_TOKEN=
# Team (or personal account) id and project id: in Vercel, open the project →
# Settings → General ("Project ID"), and Team settings → General ("Team ID").
# Running `npx vercel link` locally also writes both to .vercel/project.json.
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

rules_version = '2';

// Visitors may read the doodle leaderboard and save their own best score for
// the day. Nothing else in the database can be read or written from the site.
service cloud.firestore {
  match /databases/{database}/documents {

    function isDay(day) {
      return day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidEntry(player) {
      let entry = request.resource.data;
      return entry.keys().hasOnly(['name', 'score', 'updatedAt'])
        && entry.keys().hasAll(['name', 'score', 'updatedAt'])
        && entry.name is string
        && entry.name.size() > 0
        && entry.name.size() <= 48
        && entry.name.matches('^[\\p{L}\\p{M}]+( [\\p{L}\\p{M}]+)*$')
        && entry.name.lower() == player
        && entry.score is int
        && entry.score >= 0
        && entry.score <= 1000
        && entry.updatedAt == request.time;
    }

    match /doodleLeaderboard/{day}/players/{player} {
      allow read: if isDay(day);
      allow create: if isDay(day) && isValidEntry(player);
      allow update: if isDay(day) && isValidEntry(player)
        && request.resource.data.score > resource.data.score;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

# Firebase web settings for the doodle leaderboard (Firebase console → Project
# settings → Your apps → Web app). Copy this file to .env.local and fill it in.
# These values are not secret: they end up in the site's code, and
# firestore.rules is what protects the data.
# Without them, the dev server keeps scores in memory and a production build
# shows "The leaderboard is not set up yet".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
